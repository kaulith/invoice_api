meta {
  name: register
  type: http
  seq: 4
}

post {
  url: {{base_url}}/auth/register
  body: formUrlEncoded
  auth: inherit
}

body:form-urlencoded {
  "username: ": {{reg_username}}
  "email: ": {{reg_email}}
  "password: ": {{reg_password}}
  "confirm_password: ": {{reg_confirm}}
}

vars:pre-request {
  reg_username: demo
  reg_email: demo@example.com
  reg_password: demo@123
  reg_confirm: demo@123
}

settings {
  encodeUrl: true
  timeout: 0
}
