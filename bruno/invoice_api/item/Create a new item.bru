meta {
  name: Create a new item.
  type: http
  seq: 3
}

post {
  url: {{base_url}}/items/
  body: json
  auth: inherit
}

body:json {
  {
    "name": "{{item_name}}",
    "price": "{{item_price}}"
  }
  
}

vars:pre-request {
  item_name: Test Item
  item_price: 100
}

settings {
  encodeUrl: true
  timeout: 0
}
